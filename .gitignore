# ==============================================================================
# FLUETAS — Comprehensive Production .gitignore
# Ensures no environment variables, API keys, service credentials, or build
# artifacts are accidentally committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Configuration Files (CRITICAL)
# ------------------------------------------------------------------------------
# Ignore all .env files and local overrides
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Allow example / template environment files only
!.env.example
!.env.local.example
!.env.template
!.env.sample

# ------------------------------------------------------------------------------
# 2. Private Keys, Certificates & Credentials (CRITICAL)
# ------------------------------------------------------------------------------
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.crt
*.der
*.cert
*.id_rsa
*.id_dsa
*.id_ed25519
*.ppk

# Cloud, Firebase & Service Account JSON credentials
*serviceAccountKey*.json
*service-account*.json
*firebase-adminsdk*.json
credentials.json
client_secret*.json
secret*.json
secrets.json
auth.json
token.json
tokens.json
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# 3. Dependencies & Package Managers
# ------------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 4. Next.js, Turbopack, Build & Production Outputs
# ------------------------------------------------------------------------------
/.next/
/out/
/build/
/dist/
/.turbo/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 5. Firebase & Local Emulators
# ------------------------------------------------------------------------------
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
pubsub-debug.log*
hosting-debug.log*
auth-debug.log*

# ------------------------------------------------------------------------------
# 6. Testing & Code Coverage
# ------------------------------------------------------------------------------
/coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# 7. Debug Logs & Temporary Cache Files
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 8. OS System Files & Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 9. IDE & Editor Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace
.project
.settings/

# ------------------------------------------------------------------------------
# 10. Deployment & Hosting Caches
# ------------------------------------------------------------------------------
.vercel
.serverless/
.terraform/
.vagrant/
