rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // Helper functions (Custom Claims & Authorization)
    // ──────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasRole(role) {
      return request.auth.token.role == role;
    }

    function isDoctor() {
      return hasRole('doctor') || hasRole('expert') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['doctor', 'expert']);
    }

    function isAdmin() {
      return hasRole('admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Prevents client from self-escalating role, status, or administrative fields
    function isNotModifyingPrivilegedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'status', 'permissions', 'isAdmin', 'isDoctor', 'verificationStatus', 'doctorId', 'admin']);
    }

    // Ensures new user document starts with safe default role ('customer' or 'expert')
    function isSafeNewUser() {
      return !request.resource.data.keys().hasAny(['permissions', 'isAdmin', 'isDoctor', 'verificationStatus', 'doctorId'])
        && (request.resource.data.role in ['customer', 'expert'] || !request.resource.data.keys().hasAny(['role']));
    }

    // ──────────────────────────────────────────────────────────────────────
    // Strict Consent & Clinical Relationship Verification (P0-1 Fix)
    // A doctor can only access customer data if an active relationship exists.
    // ──────────────────────────────────────────────────────────────────────
    function hasActiveDoctorConsent(patientId) {
      return isDoctor() && (
        (
          exists(/databases/$(database)/documents/doctorPatientRelationships/$( 'rel_' + request.auth.uid + '_' + patientId )) &&
          get(/databases/$(database)/documents/doctorPatientRelationships/$( 'rel_' + request.auth.uid + '_' + patientId )).data.status == 'active'
        )
      );
    }

    // ──────────────────────────────────────────────────────────────────────
    // /users/{userId}
    // ──────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // User profile document: readable by authentic owner, admin, or assigned doctor with active consent
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      
      // Creation: customer can create own document with safe default role
      allow create: if isAuthenticated() && isOwner(userId) && isSafeNewUser();
      
      // Update: customer can update profile fields but NEVER modify role/status/permissions
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && isNotModifyingPrivilegedFields())
      );
      
      allow delete: if isAuthenticated() && isAdmin();

      // Health Profile (personal wellness data)
      match /healthProfile/{doc} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // Health Timeline
      match /healthTimeline/{eventId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // Consultations
      match /consultations/{consultationId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow write: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));

        match /notes/{noteId} {
          allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        }

        match /report/main {
          allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        }
      }

      // Test Requests
      match /testRequests/{requestId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow write: if isAuthenticated() && (isAdmin() || hasActiveDoctorConsent(userId));
      }

      // Documents (lab reports, prescriptions, scans)
      match /documents/{docId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // Custom Foods created by user
      match /customFoods/{foodId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // Recommendations
      match /recommendations/{recId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow write: if isAuthenticated() && (isAdmin() || hasActiveDoctorConsent(userId));
      }

      // Follow-Ups
      match /followUps/{followUpId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow write: if isAuthenticated() && (isAdmin() || hasActiveDoctorConsent(userId));
      }

      // Appointments
      match /appointments/{apptId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow write: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      }

      // Consents
      match /consents/{consentId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isDoctor());
        allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      // Access Logs
      match /accessLogs/{logId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if isAuthenticated() && isAdmin();
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    // Daily tracking collections (top-level, keyed by userId)
    // ──────────────────────────────────────────────────────────────────────
    match /workoutLogs/{userId}/entries/{date} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    match /nutritionLogs/{userId}/entries/{date} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    match /hydrationLogs/{userId}/entries/{date} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    match /sleepLogs/{userId}/entries/{date} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    match /cycleLogs/{userId}/entries/{date} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    match /symptomLogs/{userId}/entries/{date} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // ──────────────────────────────────────────────────────────────────────
    // /workoutPlans/{userId}/plans/{planId} (Versioned Structured Training)
    // ──────────────────────────────────────────────────────────────────────
    match /workoutPlans/{userId}/plans/{planId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());

      // Version snapshots are append-only / immutable
      match /versions/{versionId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow create: if isAuthenticated() && (isOwner(userId) || isAdmin() || hasActiveDoctorConsent(userId));
        allow update, delete: if false;
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    // Top-level Clinical, Consent & Operational Collections
    // ──────────────────────────────────────────────────────────────────────
    match /consents/{consentId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.customerId) || request.auth.uid == resource.data.doctorId || isAdmin());
      allow write: if isAuthenticated() && (isOwner(request.resource.data.customerId) || isAdmin());
    }

    match /doctorPatientRelationships/{relId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.customerId) || request.auth.uid == resource.data.doctorId || isAdmin());
      allow write: if isAuthenticated() && (isDoctor() || isAdmin());
    }

    match /testRequests/{requestId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.customerId) || request.auth.uid == resource.data.doctorId || isAdmin());
      allow write: if isAuthenticated() && (isDoctor() || isAdmin());
    }

    match /medicalReports/{reportId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.customerId) || (isDoctor() && request.auth.uid == resource.data.doctorId) || isAdmin());
      allow write: if isAuthenticated() && (isOwner(request.resource.data.customerId) || isDoctor() || isAdmin());
    }

    match /recommendations/{recId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.customerId) || request.auth.uid == resource.data.doctorId || isAdmin());
      allow write: if isAuthenticated() && (isDoctor() || isAdmin());
    }

    match /followUps/{followUpId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.customerId) || request.auth.uid == resource.data.doctorId || isAdmin());
      allow write: if isAuthenticated() && (isDoctor() || isAdmin());
    }

    // Audit logs: Strictly append-only, readable only by verified admins
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────────
    // /doctors/{doctorId} (Restricted Discovery & Private Separation)
    // ──────────────────────────────────────────────────────────────────────
    match /doctors/{doctorId} {
      // Public profile is readable by authenticated users for doctor discovery
      allow read: if isAuthenticated();
      // Only Admin can verify/suspend doctor; Doctor can update their own public profile (bio, fee)
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == doctorId);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == doctorId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'verifiedAt', 'verifiedBy', 'adminNotes', 'internalRating']))
      );
      allow delete: if isAuthenticated() && isAdmin();

      // Private administrative & verification metadata (Restricted to authentic doctor owner or Admin)
      match /private/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == doctorId || isAdmin());
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    // /experts/{expertId} (Verified Clinical Experts & Trainers)
    // ──────────────────────────────────────────────────────────────────────
    match /experts/{expertId} {
      // Public profile readable by authenticated users for discovery
      allow read: if isAuthenticated();
      // Expert applicant can create their own profile; Admin can create
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == expertId);
      // Expert can update bio/schedule; only Admin can update verificationStatus
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == expertId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'verifiedAt', 'verifiedBy', 'adminNotes']))
      );
      allow delete: if isAuthenticated() && isAdmin();

      match /private/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == expertId || isAdmin());
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    // /exercises/{exerciseId} (Exercise Catalog)
    // ──────────────────────────────────────────────────────────────────────
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // /exerciseVideos/{videoId} (Demonstration Video Registry & Presentation Variants)
    // ──────────────────────────────────────────────────────────────────────
    match /exerciseVideos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // /appointments/{appointmentId} (Top-level booking transactions)
    // ──────────────────────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.customerId) ||
        request.auth.uid == resource.data.expertId ||
        request.auth.uid == resource.data.doctorId ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (isOwner(request.resource.data.customerId) || isAdmin());
      allow update: if isAuthenticated() && (
        isOwner(resource.data.customerId) ||
        request.auth.uid == resource.data.expertId ||
        request.auth.uid == resource.data.doctorId ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (isOwner(resource.data.customerId) || isAdmin());
    }

    // ──────────────────────────────────────────────────────────────────────
    // /notifications/{userId}/items/{notifId}
    // ──────────────────────────────────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // ──────────────────────────────────────────────────────────────────────
    // /products/{productId}
    // ──────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // /feedbacks/{feedbackId} (User & Public Feedback)
    // ──────────────────────────────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      // Public reviews can be read by anyone; private feedbacks can be read by owner or admin
      allow read: if resource.data.isPublic == true ||
                     (isAuthenticated() && (isOwner(resource.data.userId) || isAdmin()));
      // Anyone (authenticated or visitor) can create a feedback entry
      allow create: if true;
      // Only admins can update status or delete
      allow update, delete: if isAuthenticated() && isAdmin();
    }

  }
}

